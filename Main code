        function drawSpectrum(data) {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#10b981'; // Tailwind emerald-500

            // Draw baseline
            ctx.fillRect(0, canvas.height - 1, canvas.width, 1); 

            // Max magnitude from Python is ~4095/2. Max display height is canvas.height.
            // We'll normalize dynamically based on the max value in the array.
            const maxVal = Math.max(...data.magnitudes, 1000); 
