import machine
import time
import fft  # Your pure python library
from sh1106 import SH1106_I2C

# --- Hardware Configuration ---
I2C_SCL_PIN = 22
I2C_SDA_PIN = 21
OLED_WIDTH  = 128
OLED_HEIGHT = 64
MIC_PIN = 34 

# --- TUNING KNOBS (Adjust these!) ---

# 1. CUT THE BASS NOISE
# The first few "bins" are usually just power supply hum/DC offset.
IGNORE_LOW_BINS = 3

# 2. NOISE GATE (Squelch)
# Any bar smaller than this value will be treated as 0.
NOISE_GATE = 400

# 3. SOFTWARE GAIN
# Multiplies the height of the bars.
GAIN = 3.0

# --- FFT Configuration ---
SAMPLE_LENGTH = 128 

class SpectrumAnalyzer:
    def __init__(self):
        self.setup_display()
        self.setup_mic()
        
        # --- AUTO-CALIBRATION ---
        # We measure speed to label the x-axis correctly
        self.real_sampling_rate = self.measure_sampling_rate()
        self.hz_per_bin = self.real_sampling_rate / SAMPLE_LENGTH
        self.max_freq = self.real_sampling_rate / 2
        
        print(f"Sampling Rate: {self.real_sampling_rate} Hz")
        print(f"Max Freq: {self.max_freq} Hz")
        print(f"Resolution: {self.hz_per_bin:.1f} Hz/bin")

    def setup_display(self):
        print("Initializing SH1106 OLED...")
        i2c = machine.I2C(0, scl=machine.Pin(I2C_SCL_PIN), sda=machine.Pin(I2C_SDA_PIN), freq=400000)
        try:
            self.oled = SH1106_I2C(i2c)
        except TypeError:
            self.oled = SH1106_I2C(OLED_WIDTH, OLED_HEIGHT, i2c)
        self.oled.fill(0)
        self.oled.text("Ready...", 10, 30)
        self.oled.show()

    def setup_mic(self):
        self.adc = machine.ADC(machine.Pin(MIC_PIN))
        self.adc.width(machine.ADC.WIDTH_12BIT) 
        self.adc.atten(machine.ADC.ATTN_11DB)   

    def read_audio(self):
        raw_samples = []
        adc_read = self.adc.read
        for _ in range(SAMPLE_LENGTH):
            raw_samples.append(adc_read())
        return raw_samples

    def measure_sampling_rate(self):
        self.read_audio() # Warmup
        start = time.ticks_us()
        self.read_audio()
        end = time.ticks_us()
        diff = time.ticks_diff(end, start)
        hz = 1000000 / (diff / SAMPLE_LENGTH)
        return int(hz)

    def format_freq(self, hz):
        """Helper to make numbers look nice (e.g. 1200 -> 1.2k)"""
        if hz >= 1000:
            return f"{hz/1000:.1f}k"
        return str(int(hz))

    def draw_spectrum(self, magnitudes):
        self.oled.fill(0)
        
        BASE_DIVISOR = 150
        BAR_BOTTOM = 53  # Leave 11 pixels at bottom for text
        
        bar_count = 0
        
        # 1. Draw Bars
        for i in range(IGNORE_LOW_BINS, len(magnitudes)):
            # Stop if we run off screen
            if bar_count * 2 >= OLED_WIDTH: break
            
            mag = magnitudes[i]
            
            # Apply Noise Gate
            if mag < NOISE_GATE: mag = 0
            
            # Calculate Height
            h = int((mag / BASE_DIVISOR) * GAIN)
            if h > BAR_BOTTOM: h = BAR_BOTTOM
            
            # Draw Bar
            if h > 0:
                self.oled.fill_rect(bar_count * 2, BAR_BOTTOM - h, 1, h, 1)
                
            bar_count += 1
            
        # 2. Draw Scale (Axis)
        self.oled.hline(0, BAR_BOTTOM + 1, 128, 1)
        
        # Start Freq (Left)
        start_freq = IGNORE_LOW_BINS * self.hz_per_bin
        self.oled.text(self.format_freq(start_freq), 0, 56)
        
        # Mid Freq (Center)
        # Rough approximation of the middle of the screen
        mid_bin = IGNORE_LOW_BINS + (bar_count // 2)
        mid_freq = mid_bin * self.hz_per_bin
        mid_str = self.format_freq(mid_freq)
        self.oled.text(mid_str, 55, 56)

        # End Freq (Right)
        end_bin = IGNORE_LOW_BINS + bar_count
        end_freq = end_bin * self.hz_per_bin
        end_str = self.format_freq(end_freq)
        # Right align
        self.oled.text(end_str, 128 - (len(end_str)*8), 56)
            
        self.oled.show()

    def run(self):
        print("Starting Spectrum Analyzer...")
        while True:
            try:
                raw_data = self.read_audio()
                mags = fft.get_magnitude(raw_data)
                self.draw_spectrum(mags)
            except KeyboardInterrupt:
                print("Stopping.")
                break
            except Exception as e:
                print("Error:", e)
                time.sleep(1)

if __name__ == "__main__":
    analyzer = SpectrumAnalyzer()
    analyzer.run()
