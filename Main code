            try {
                // Send request to switch mode, ignore response (next fetch will update UI)
                await fetch('/api/switch_mode');
            } catch (e) { console.error(e); }
        }

        function drawSpectrum(data) {
            const w = canvas.width;
            const h = canvas.height;
            const bottomMargin = 20; // Space for labels
            const graphH = h - bottomMargin;

            ctx.clearRect(0, 0, w, h);

            // 1. Draw Grid
            ctx.strokeStyle = '#333';
            ctx.lineWidth = 1;
            ctx.beginPath();
            // Horizontal lines
            for(let i=1; i<4; i++) {
