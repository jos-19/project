import machine
import time
import fft  # Your pure python library
from sh1106 import SH1106_I2C

# --- Hardware Configuration ---
I2C_SCL_PIN = 22
I2C_SDA_PIN = 21
OLED_WIDTH  = 128
OLED_HEIGHT = 64
MIC_PIN = 36

# --- TUNING KNOBS (Adjust these!) ---

# 1. CUT THE BASS NOISE
# The first few "bins" are usually just power supply hum/DC offset.
# Increase this (try 2, 3, or 4) if the left side is always stuck high.
IGNORE_LOW_BINS = 3

# 2. NOISE GATE (Squelch)
# Any bar smaller than this value will be treated as 0.
# Increase this (e.g., 500, 800) if you see "static" when the room is quiet.
NOISE_GATE = 400

# 3. SOFTWARE GAIN
# Multiplies the height of the bars.
# Increase this (e.g., 2.0, 5.0) if the bars are too small.
GAIN = 3.0

# --- FFT Configuration ---
SAMPLE_LENGTH = 128 

class SpectrumAnalyzer:
    def __init__(self):
        self.setup_display()
        self.setup_mic()
        
        # We run the calibration just to print info, but we won't use it for complex scaling
        # to keep the visual simple and fast.
        self.real_sampling_rate = self.measure_sampling_rate()
        print(f"Sampling Rate: {self.real_sampling_rate} Hz")

    def setup_display(self):
        print("Initializing SH1106 OLED...")
        i2c = machine.I2C(0, scl=machine.Pin(I2C_SCL_PIN), sda=machine.Pin(I2C_SDA_PIN), freq=400000)
        
        try:
            self.oled = SH1106_I2C(i2c)
        except TypeError:
            self.oled = SH1106_I2C(OLED_WIDTH, OLED_HEIGHT, i2c)
            
        self.oled.fill(0)
        self.oled.text("Ready...", 10, 30)
        self.oled.show()

    def setup_mic(self):
        print("Initializing Mic...")
        self.adc = machine.ADC(machine.Pin(MIC_PIN))
        self.adc.width(machine.ADC.WIDTH_12BIT) 
        self.adc.atten(machine.ADC.ATTN_11DB)   

    def read_audio(self):
        raw_samples = []
        adc_read = self.adc.read
        for _ in range(SAMPLE_LENGTH):
            raw_samples.append(adc_read())
        return raw_samples

    def measure_sampling_rate(self):
        self.read_audio() # Warmup
        start = time.ticks_us()
        self.read_audio()
        end = time.ticks_us()
        diff = time.ticks_diff(end, start)
        hz = 1000000 / (diff / SAMPLE_LENGTH)
        return int(hz)

    def draw_spectrum(self, magnitudes):
        self.oled.fill(0)
        
        # Base divisor to convert magnitude to pixels
        # We apply our custom GAIN here.
        BASE_DIVISOR = 150
        
        # We skip the first 'IGNORE_LOW_BINS'
        # We only draw up to 64 bars (half of SAMPLE_LENGTH)
        # But screen is 128px wide, so each bar is 2px wide.
        
        bar_count = 0
        
        for i in range(IGNORE_LOW_BINS, len(magnitudes)):
            if bar_count * 2 >= OLED_WIDTH: break
            
            mag = magnitudes[i]
            
            # Apply Noise Gate
            if mag < NOISE_GATE:
                mag = 0
            
            # Calculate Height
            # (mag / BASE_DIVISOR) * GAIN
            h = int((mag / BASE_DIVISOR) * GAIN)
            
            # Cap height at 64
            if h > 64: h = 64
            
            # Draw Bar
            # x = bar_count * 2 (spreads them out)
            if h > 0:
                self.oled.fill_rect(bar_count * 2, 64 - h, 1, h, 1)
                
            bar_count += 1
            
        self.oled.show()

    def run(self):
        print("Starting Spectrum Analyzer...")
        while True:
            try:
                raw_data = self.read_audio()
                mags = fft.get_magnitude(raw_data)
                self.draw_spectrum(mags)
            except KeyboardInterrupt:
                print("Stopping.")
                break
            except Exception as e:
                print("Error:", e)
                time.sleep(1)

if __name__ == "__main__":
    analyzer = SpectrumAnalyzer()
    analyzer.run()
