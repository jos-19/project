import machine
import time
import math
import fft  # Your pure python library
from sh1106 import SH1106_I2C
import network
import usocket as socket

# --- NETWORK CONFIG ---
# <<< IMPORTANT: Update these credentials >>>
WIFI_SSID = "YOUR_WIFI_SSID"
WIFI_PASSWORD = "YOUR_WIFI_PASSWORD"
# ----------------------

# --- Hardware Configuration ---
I2C_SCL_PIN = 22
I2C_SDA_PIN = 21
BUTTON_PIN  = 14  # Connect Button between GPIO 14 and GND
MIC_PIN     = 34  

OLED_WIDTH  = 128
OLED_HEIGHT = 64

# --- TUNING ---
IGNORE_LOW_BINS = 2     # Lowered slightly for higher res
NOISE_GATE      = 400   # Squelch static
GAIN            = 3.0   # Visual gain
SPEECH_BARS     = 20    # Fixed number of bars for Speech Mode

# --- FFT CONFIG ---
# INCREASED TO 256: This doubles the frequency resolution to fix the "gaps"
SAMPLE_LENGTH = 256 

# --- EMBEDDED HTML/JS APP ---
# Updated with Button, Grid, Axis Labels, and Fixed Scaling
HTML_PAGE = """
<!DOCTYPE html>
<html>
<head>
