class SpectrumAnalyzer:
    def __init__(self):
        self.setup_display() 
        self.setup_mic()
        self.setup_button()
        
        # Wi-Fi State
        self.wlan = None
        self.server_socket = None
        self.ip_address = "N/A"
        
        # --- Calibration ---
        self.real_sampling_rate = self.measure_sampling_rate()
        self.hz_per_bin = self.real_sampling_rate / SAMPLE_LENGTH
        self.max_freq = self.real_sampling_rate / 2
        
        print(f"Rate: {self.real_sampling_rate}Hz | Res: {self.hz_per_bin:.1f}Hz")

        # --- Mode State and Data Buffer ---
        self.mode = 0
        self.mode_names = ["Speech Zoom", "Wide Range", "Analyzer", "dB Meter"]
        self.latest_magnitudes = [0] * SPEECH_BARS 
        self.latest_db_value = 0.0
        
        # --- Mode Specific Variables ---
        self.analysis_start = 0
        self.analysis_accum = []
        self.analysis_count = 0
        self.analysis_done = False
        
        self.db_min = 999
        self.db_max = -999

    def setup_display(self):
        # 1. Initialize I2C Bus
        i2c = machine.I2C(0, scl=machine.Pin(I2C_SCL_PIN), sda=machine.Pin(I2C_SDA_PIN), freq=400000)
        
        # 2. Initialize OLED
        try:
            self.oled = SH1106_I2C(i2c)
        except TypeError:
            self.oled = SH1106_I2C(OLED_WIDTH, OLED_HEIGHT, i2c)
        except OSError as e:
            print("OLED INITIALIZATION FAILED: [Errno 19] ENODEV.")
            raise e 
            
        self.oled.fill(0)
        self.oled.text("Starting...", 10, 30)
        self.oled.show()

    def setup_mic(self):
        # Configure the ADC pin for the microphone
        self.adc = machine.ADC(machine.Pin(MIC_PIN))
        self.adc.width(machine.ADC.WIDTH_12BIT)  # 0 to 4095
        self.adc.atten(machine.ADC.ATTN_11DB)    # Full voltage range

    def setup_button(self):
        # Configure Pin 14 with internal Pull Up. Button connects to GND.
        self.btn = machine.Pin(BUTTON_PIN, machine.Pin.IN, machine.Pin.PULL_UP)

    def check_mode_change(self):
        """ Robust debouncer """
        if self.btn.value() == 0:
            time.sleep_ms(100) 
            if self.btn.value() == 0:
                self.mode = (self.mode + 1) % 4
                print(f"Switched to Mode: {self.mode_names[self.mode]}")
                
                # Reset mode specific stuff
                self.analysis_start = 0
                self.analysis_done = False
                self.db_min = 999
                self.db_max = -999
                
                # Show splash screen
                self.oled.fill(0)
                self.oled.text(self.mode_names[self.mode], 10, 30)
                self.oled.show()
                time.sleep(0.5)
                
                while self.btn.value() == 0:
                    time.sleep_ms(10) 
                    
                return True
        return False

    def read_audio(self):
        raw_samples = []
        adc_read = self.adc.read
        for _ in range(SAMPLE_LENGTH):
            raw_samples.append(adc_read())
        return raw_samples

    def measure_sampling_rate(self):
        self.read_audio() # Prime the system
        start = time.ticks_us()
        self.read_audio()
        end = time.ticks_us()
        diff = time.ticks_diff(end, start)
        return int(1000000 / (diff / SAMPLE_LENGTH))

    def format_freq(self, hz):
        if hz >= 1000: return f"{hz/1000:.1f}k"
        return str(int(hz))

    # --- NETWORK FUNCTIONS ---
    def connect_wifi(self):
        self.wlan = network.WLAN(network.STA_IF)
        self.wlan.active(True)
        
        self.oled.fill(0)
        self.oled.text("Connecting...", 0, 0)
        self.oled.show()
        
        if not self.wlan.isconnected():
            print('Connecting to network...')
            self.wlan.connect(WIFI_SSID, WIFI_PASSWORD)
            for i in range(15):
                if self.wlan.isconnected():
                    break
                self.oled.text(".", 70 + i * 4, 0)
                self.oled.show()
                time.sleep(1)

        if self.wlan.isconnected():
            self.ip_address = self.wlan.ifconfig()[0]
            print(f'Connected. IP: {self.ip_address}')
            self.oled.fill(0)
            self.oled.text("IP:", 0, 0)
            self.oled.text(self.ip_address, 20, 10)
            self.oled.text("Browser Link:", 0, 25)
            self.oled.text(f"http://{self.ip_address}", 0, 35)
            self.oled.show()
            time.sleep(3)
            return True
        else:
            print('Connection failed!')
            self.oled.fill(0)
            self.oled.text("WiFi Failed!", 10, 20)
            self.oled.show()
            return False

    def start_web_server(self):
        self.server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self.server_socket.bind(('', 80))
        self.server_socket.listen(1)
        self.server_socket.setblocking(False) # Non-blocking socket
        print('Web server started on port 80')

    def generate_data_json(self):
        """Formats the latest processed data into a JSON string."""
        if self.mode == 3: # dB Meter
            # Manually construct simple JSON string for dB mode
            # Send 20 bars of the same height to represent the 'level'
            json_str = '{"modeName":"' + self.mode_names[self.mode] + \
                       '","magnitudes":[' + ','.join([f"{self.latest_db_value:.0f}"] * 20) + \
                       ']}'
        else: # Spectrum Modes (0 and 1)
            # Manually construct simple JSON string for spectrum mode
            json_str = '{"modeName":"' + self.mode_names[self.mode] + '","magnitudes":[' + \
                       ','.join([f"{m:.0f}" for m in self.latest_magnitudes]) + ']}'
        return json_str

    def handle_web_request(self):
        # Handle incoming connection requests (non-blocking)
        try:
            conn, addr = self.server_socket.accept()
            conn.settimeout(3.0) # Set a timeout for client connection
            
            request = conn.recv(1024)
            request = str(request)
            
            # API endpoint for data
            if '/api/data' in request:
                json_data = self.generate_data_json()
                response = 'HTTP/1.0 200 OK\r\nContent-Type: application/json\r\n\r\n' + json_data
            
            # Root path for the web page
            elif '/' in request:
                response = 'HTTP/1.0 200 OK\r\nContent-Type: text/html\r\n\r\n' + HTML_PAGE
            
            else:
                response = 'HTTP/1.0 404 Not Found\r\n\r\n404'
                
            conn.send(response)
            conn.close()
            
        except OSError as e:
            # Error 11 is EAGAIN/EWOULDBLOCK (expected for non-blocking socket when no connection is ready)
            if e.args[0] == 11: 
                pass 
            else:
                print(f"Socket Error: {e}")
        except Exception as e:
            print(f"Request handling error: {e}")

    # =========================================
    # CORE: Calculate the magnitudes for display bars 
    # =========================================
    def calculate_display_bars(self, magnitudes, min_hz, max_hz, num_bars):
        """Processes raw FFT bins into the desired number of display bars."""
        
        start_idx = int(min_hz / self.hz_per_bin)
        end_idx  = int(max_hz / self.hz_per_bin)
        
        if start_idx < IGNORE_LOW_BINS: start_idx = IGNORE_LOW_BINS
        if end_idx >= len(magnitudes): end_idx = len(magnitudes)
        
        # Only happens if range is invalid
        if end_idx <= start_idx: return [0] * num_bars
        
        num_fft_bins_in_range = end_idx - start_idx
        bins_per_bar = num_fft_bins_in_range / num_bars 
        
        display_bars = []
        for i in range(num_bars):
            # Calculate range for this specific bar
            bin_start = start_idx + int(i * bins_per_bar)
            bin_end = start_idx + int((i + 1) * bins_per_bar)
            
            # --- THE FIX FOR THE "GAPS" ---
            # If the resolution is tight, start might equal end (slice width 0).
            # We force it to grab at least one bin.
            if bin_end == bin_start:
                bin_end = bin_start + 1
            # ------------------------------

            # Safety clamp
            if bin_end > len(magnitudes): bin_end = len(magnitudes)

            bar_magnitudes = magnitudes[bin_start:bin_end]
            
            mag = 0
            if bar_magnitudes:
                # Use max magnitude for "peak" detection, looks sharper
                mag = max(bar_magnitudes)
            
            if mag < NOISE_GATE: mag = 0
            display_bars.append(mag)
            
        return display_bars

    # =========================================
    # MODE 0 & 1: SPECTRUM VISUALIZER DRAWING
    # =========================================
    def draw_spectrum(self, bar_magnitudes, min_hz, max_hz, title):
        # 1. Update the data buffer for the web server
        self.latest_magnitudes = bar_magnitudes

        # 2. Draw to OLED
        self.oled.fill(0)
        
        BASE_DIVISOR = 150 # Scaling factor
        BAR_BOTTOM = 53
        
        # Title
        self.oled.text(title, 0, 0)
        
        # Setup Bar Parameters
        count = len(bar_magnitudes)
        if count == 0:
             self.oled.text("No Data", 0, 10)
             self.oled.show()
             return

        # Fixed width based on the number of bars calculated
        width = OLED_WIDTH / count 
        
        # Draw Bars
        for i, mag in enumerate(bar_magnitudes):
            
            # Calculate bar height
            h = int((mag / BASE_DIVISOR) * GAIN)
            if h > (BAR_BOTTOM - 10): h = (BAR_BOTTOM - 10) # Keep below title
            
            x = int(i * width)
            if h > 0:
                # Draw the bar with 1px spacing
                w = int(width) - 1
                if w < 1: w = 1
                self.oled.fill_rect(x, BAR_BOTTOM - h, w, h, 1)

        # Scale Labels
        self.oled.hline(0, BAR_BOTTOM + 1, 128, 1)
        self.oled.text(self.format_freq(min_hz), 0, 56)
        self.oled.text(self.format_freq(max_hz), 90, 56)
        
        self.oled.show()


    # =========================================
    # MODE 2: ANALYZER (5s Accumulation)
    # =========================================
    def run_analyzer(self, magnitudes):
        if self.analysis_start == 0:
            self.analysis_start = time.time()
            self.analysis_accum = [0] * len(magnitudes)
            self.analysis_count = 0
            self.analysis_done = False
        
        if self.analysis_done:
            return
        
        elapsed = time.time() - self.analysis_start
        
        if elapsed < 5:
            # ACCUMULATE DATA
            for i in range(len(magnitudes)):
                self.analysis_accum[i] += magnitudes[i]
            self.analysis_count += 1
            
            self.oled.fill(0)
            self.oled.text("Measuring...", 10, 10)
            self.oled.text(f"Time: {5 - int(elapsed)}s", 10, 25)
            
            bar_w = int((elapsed / 5.0) * 100)
            self.oled.rect(14, 40, 100, 10, 1)
            self.oled.fill_rect(14, 40, bar_w, 10, 1)
            self.oled.show()
            
        else:
            # FINISHED
            self.analysis_done = True
            
            if self.analysis_count == 0: return
            avgs = [x / self.analysis_count for x in self.analysis_accum]
            valid_data = avgs[IGNORE_LOW_BINS:]
            
            if not valid_data: return
            
            # High Energy (Frequency with max magnitude)
            max_val = max(valid_data)
            max_idx = valid_data.index(max_val) + IGNORE_LOW_BINS
            max_hz = max_idx * self.hz_per_bin
            
            # Low Energy (Frequency with min magnitude)
            min_val = min(valid_data)
            min_idx = valid_data.index(min_val) + IGNORE_LOW_BINS
            min_hz = min_idx * self.hz_per_bin

            # Average Magnitude (Overall energy average)
            overall_avg = sum(valid_data) / len(valid_data)
            
            self.oled.fill(0)
            self.oled.text("--- REPORT ---", 10, 0)
            
            # Compact layout to fit 3 lines
            self.oled.text(f"Max: {int(max_hz)} Hz", 0, 15)
            self.oled.text(f"Min: {int(min_hz)} Hz", 0, 30)
            self.oled.text(f"Avg: {int(overall_avg)}", 0, 45)
            
            self.oled.show()

    # =========================================
    # MODE 3: dB METER
    # =========================================
    def run_db_meter(self, raw_data):
        avg = sum(raw_data) / len(raw_data)
        centered = [x - avg for x in raw_data]
        squared_sum = sum(x*x for x in centered)
        mean_square = squared_sum / len(centered)
        rms = math.sqrt(mean_square)
        
        if rms > 1:
             db = 20 * math.log10(rms / 2000.0) + 100 
             if db < 0: db = 0
        else:
            db = 0
            
        if db > self.db_max: self.db_max = db
        if db < self.db_min: self.db_min = db
        self.latest_db_value = db
        
        self.oled.fill(0)
        self.oled.text("dB Meter", 35, 0)
        self.oled.text(f"{db:.1f} dB", 35, 20)
        self.oled.text(f"Min:{self.db_min:.0f}", 0, 55)
        self.oled.text(f"Max:{self.db_max:.0f}", 80, 55)
        
        bar_w = int((db / 100) * 128)
        if bar_w > 128: bar_w = 128
        self.oled.fill_rect(0, 35, bar_w, 10, 1)
        
        self.oled.show()

    # =========================================
    # MAIN LOOP
    # =========================================
    def run(self):
        print("Starting Multimode Analyzer (High Res)...")
        
        if not self.connect_wifi():
            print("Running in Standalone Mode.")

        self.start_web_server()
        
        while True:
            try:
                if self.check_mode_change():
                    continue 
                
                # Handle Web Requests
                if self.wlan and self.wlan.isconnected():
                    self.handle_web_request()
                
                raw_data = self.read_audio()
                mags = fft.get_magnitude(raw_data)
                
                if self.mode == 0: # Speech Mode
                    # Now uses the improved logic for 20 gap-less bars
                    bar_mags = self.calculate_display_bars(mags, 100, 1000, SPEECH_BARS)
                    self.draw_spectrum(bar_mags, 100, 1000, "Speech Mode (20)")
                    
                elif self.mode == 1: # Wide Mode
                    # Shows all data across the full screen width
                    bar_mags = self.calculate_display_bars(mags, 0, self.max_freq, OLED_WIDTH)
                    self.draw_spectrum(bar_mags, 0, self.max_freq, "Wide Mode (Full)")
                    
                elif self.mode == 2: # Analyzer
                    self.run_analyzer(mags)
                    
                elif self.mode == 3: # dB Meter
                    self.run_db_meter(raw_data)
                    
            except KeyboardInterrupt:
                print("Stopping.")
                break
            except Exception as e:
                print("Error:", e)
                if hasattr(self, 'oled'):
                    self.oled.fill(0)
                    self.oled.text("Run Error!", 10, 10)
                    self.oled.text(str(e)[:16], 0, 30)
                    self.oled.show()
                time.sleep(1)

if __name__ == "__main__":
    analyzer = SpectrumAnalyzer()
    analyzer.run()
