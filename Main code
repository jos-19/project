                    let height = (mag / FIXED_MAX_MAG) * graphH;
                    if (height > graphH) height = graphH; // Clip
                    
                    const x = i * barWidth;
                    const y = graphH - height;
                    
                    // Gap logic: if bars are wide, leave a gap. If tiny (Wide mode), no gap.
                    let gap = barWidth > 5 ? 2 : 0;
                    ctx.fillRect(x, y, barWidth - gap, height);
                });
