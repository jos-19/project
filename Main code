import machine
import time
import math
import fft  # Your pure python library
from sh1106 import SH1106_I2C
import network
import usocket as socket

# --- NETWORK CONFIG ---
# <<< IMPORTANT: Update these credentials >>>
WIFI_SSID = "YOUR_WIFI_SSID"
WIFI_PASSWORD = "YOUR_WIFI_PASSWORD"
# ----------------------

# --- Hardware Configuration ---
I2C_SCL_PIN = 22
I2C_SDA_PIN = 21
BUTTON_PIN  = 14  # Connect Button between GPIO 14 and GND
MIC_PIN     = 34  

OLED_WIDTH  = 128
OLED_HEIGHT = 64

# --- TUNING ---
IGNORE_LOW_BINS = 2     # Lowered slightly for higher res
NOISE_GATE      = 400   # Squelch static
GAIN            = 3.0   # Visual gain
SPEECH_BARS     = 20    # Fixed number of bars for Speech Mode

# --- FFT CONFIG ---
# INCREASED TO 256: This doubles the frequency resolution to fix the "gaps"
SAMPLE_LENGTH = 256 

# --- EMBEDDED HTML/JS APP ---
# This is the "app" served to the phone's browser. It requests data every 100ms.
HTML_PAGE = """
<!DOCTYPE html>
<html>
<head>
    <title>ESP32 Spectrum</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        body { font-family: Arial, sans-serif; background: #1f2937; color: #fff; text-align: center; margin: 0; padding: 20px;}
        h1 { font-size: 1.5rem; margin-bottom: 20px; }
        #canvas-container { display: flex; justify-content: center; align-items: center; width: 100%; }
        #analyzerCanvas { background: #374151; border-radius: 8px; max-width: 100%; }
        .info { margin-top: 15px; font-size: 0.9rem; color: #9ca3af; }
    </style>
</head>
<body>
    <h1>ESP32 Audio Analyzer</h1>
    <div id="canvas-container">
        <canvas id="analyzerCanvas" width="300" height="200"></canvas>
    </div>
    <div class="info" id="status">Connecting...</div>

    <script>
        const canvas = document.getElementById('analyzerCanvas');
        const ctx = canvas.getContext('2d');
        const barSpacing = 1;

        async function fetchData() {
            try {
                const response = await fetch('/api/data');
                if (!response.ok) throw new Error('Network response was not ok');
                const data = await response.json();
                drawSpectrum(data);
                document.getElementById('status').textContent = 'Live Data: ' + data.modeName;
            } catch (error) {
                console.error("Error fetching data:", error);
                document.getElementById('status').textContent = 'Disconnected. Check ESP32.';
            }
        }

        function drawSpectrum(data) {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#10b981'; // Tailwind emerald-500

            // Draw baseline
            ctx.fillRect(0, canvas.height - 1, canvas.width, 1); 

            // Calculate dynamic bar width based on received data length
            // This allows the app to adapt between Speech Mode (20 bars) and Wide Mode (128 bars)
            const barCount = data.magnitudes.length;
            if (barCount === 0) return;
            
            const barWidth = canvas.width / barCount;

            // Normalize heights
            const maxVal = Math.max(...data.magnitudes, 1000); 
            const maxHeight = canvas.height - 10; 

            data.magnitudes.forEach((mag, i) => {
                let height = (mag / maxVal) * maxHeight;
                if (height < 1) height = 1;

                const x = i * barWidth;
                const y = canvas.height - height;

                // Use slightly smaller width for spacing, unless bars are very thin
                let w = barWidth - barSpacing;
                if (w < 1) w = barWidth; 

                ctx.fillRect(x, y, w, height);
            });
        }

        // Poll the server every 100ms
        setInterval(fetchData, 100); 

