# --- Hardware Configuration ---
I2C_SCL_PIN = 22
I2C_SDA_PIN = 21
BUTTON_PIN  = 14  # Connect Button between GPIO 14 and GND
MIC_PIN     = 34  

OLED_WIDTH  = 128
OLED_HEIGHT = 64

# --- TUNING ---
IGNORE_LOW_BINS = 3     # Ignore DC/Hum
NOISE_GATE      = 400   # Squelch static
GAIN            = 3.0   # Visual gain

# --- FFT CONFIG ---
SAMPLE_LENGTH = 128
NUM_SPECTRAL_BARS = 20  # Desired number of visual bars for the spectrum modes

# --- EMBEDDED HTML/JS APP ---
# This is the "app" served to the phone's browser. It requests data every 100ms.
HTML_PAGE = """
<!DOCTYPE html>
