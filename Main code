from machine import ADC, Pin, I2C
from sh1106 import SH1106_I2C
import time
import math

# Constants
# Length of dft window
SAMPLE_LENGTH=256

#Hardware pins
SCL_PIN=22
SDA_PIN=21
BUTTON_PIN=14
#Initialize ADC channel
mic= ADC(Pin(36))
mic.atten(ADC.ATTN_11DB)
#Initialize I2C using pins
i2c = I2C(0, scl=Pin(22), sda=Pin(21), freq=100_000)
display = SH1106_I2C(i2c)

def hanning(N):
    
    return  [0.5-0.5*math.cos((2*math.pi*i)/(N-1)) for i in range (N)]

def dft(x,Fs):
    """ 
    Given an input vector x, returns an output vector y along 
    with a frequency axis freq
    """
    
    N = len(x)
    half_N=N//2 + 1
    
    y_real=[0.0] * half_N
    y_imag=[0.0] * half_N
    

    freq = [(Fs/N) * i for i in range(half_N)]
    
    for k in range(half_N):
        y_real[k]=0.0
        y_imag[k]=0.0
        factor=2* math.pi*k/N
        
        for n in range(N):
            angle=factor * n
            y_real[k] += x[n] *math.cos(angle)
            y_imag[k] -= x[n] *math.sin(angle)
    
    y=[complex(r,i) for r,i in zip(y_real, y_imag)]
    
    
    return y,freq

def measure_sampling_rate(N=SAMPLE_LENGTH):
    
    read=mic.read
    read()
    start = time.ticks_us()
    
    for _ in range(N):
        
        read()
    
    end = time.ticks_us()
    duration_us = time.ticks_diff(end,start)
    #Multiply 1_000_000 (convert to seconds)
    
    return N*1_000_000/duration_us
    
    
def read_mic(N=SAMPLE_LENGTH):
    
    samples = [0] * N
    read = mic.read
    
    for i in range(N):
        samples[i]= read()
        print(samples[i])
    
    
    return samples
def setup_display(Fs):
    display.fill(0)
    axis_y = 55
    display.hline(0, axis_y, 128, 1)  # axis line

    freqs = [0, Fs/4, Fs/2]
    xs = [0, 56, 110]
    for x, f in zip(xs, freqs):
        display.text(f"{int(f)}", x, axis_y + 2)
    display.show()


def update_display(spectrum):
    display.fill_rect(0, 0, 128, 55, 0)  # limpiar área arriba del eje
    
    mags = [abs(c) for c in spectrum]
    
    # Escala automática: ajustar según el valor máximo de la ventana
    max_mag = max(mags) if mags else 1  # evitar dividir por cero
    
    N = len(mags)
    width = 128 // N if N else 1

    for i, mag in enumerate(mags):
        # Normalizar a 0-50 píxeles
        h = int((mag / max_mag) * 50)
        x = i * width
        display.fill_rect(x, 55 - h, width-1, h, 1)  # dibujar barra

    display.show()


Fs=measure_sampling_rate()
w = hanning(SAMPLE_LENGTH)
setup_display(Fs)
max_freq= Fs/2

try:
    while True:
        # read signal
        x = read_mic(SAMPLE_LENGTH)

        # apply hanning
        x_win = [xi * wi for xi, wi in zip(x, w)]
        
        # dft
        spectrum, freq = dft(x_win, Fs)
        
        update_display(spectrum)
except KeyboardInterrupt:
    display.fill(0)
    display.text("Finish", 40, 26)
    display.show()
    
