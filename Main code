import machine
import time
import fft  # Import our new pure python library
from sh1106 import SH1106_I2C

# --- Hardware Configuration ---
I2C_SCL_PIN = 22
I2C_SDA_PIN = 21
OLED_WIDTH  = 128
OLED_HEIGHT = 64
MIC_PIN = 34 

# --- FFT Configuration ---
# Reduced to 128 for speed since we are using Pure Python now.
# 128 samples = 64 frequency bars. We will draw each bar 2 pixels wide.
SAMPLE_LENGTH = 128 

class SpectrumAnalyzer:
    def __init__(self):
        self.setup_display()
        self.setup_mic()

    def setup_display(self):
        print("Initializing SH1106 OLED...")
        i2c = machine.I2C(0, scl=machine.Pin(I2C_SCL_PIN), sda=machine.Pin(I2C_SDA_PIN), freq=400000)
        
        try:
            self.oled = SH1106_I2C(i2c)
        except TypeError:
            self.oled = SH1106_I2C(OLED_WIDTH, OLED_HEIGHT, i2c)
            
        self.oled.fill(0)
        self.oled.text("Listening...", 10, 30)
        self.oled.show()

    def setup_mic(self):
        print("Initializing Mic...")
        self.adc = machine.ADC(machine.Pin(MIC_PIN))
        self.adc.width(machine.ADC.WIDTH_12BIT) # 0-4095
        self.adc.atten(machine.ADC.ATTN_11DB)   # Full 3.3V range

    def read_audio(self):
        raw_samples = []
        adc_read = self.adc.read
        # Read samples as fast as possible
        for _ in range(SAMPLE_LENGTH):
            raw_samples.append(adc_read())
        return raw_samples

    def draw_spectrum(self, magnitudes):
        self.oled.fill(0)
        
        # Sensitivity divisor. 
        # Since we have fewer samples, the magnitude might be smaller or larger.
        # Adjust this number if bars are too big or too small.
        DIVISOR = 25 
        
        # We have 64 bars (SAMPLE_LENGTH / 2)
        # Screen is 128 pixels wide.
        # So each bar is 2 pixels wide.
        for i, mag in enumerate(magnitudes):
            if i >= 64: break 
            
            h = int(mag / DIVISOR)
            if h > 64: h = 64
            
            # Draw a filled rectangle (bar)
            # x, y, width, height, color
            x_pos = i * 2
            self.oled.fill_rect(x_pos, 64 - h, 2, h, 1)
            
        self.oled.show()

    def run(self):
        print("Starting Spectrum Analyzer (Pure Python)...")
        while True:
            try:
                # 1. Acquire Data
                raw_data = self.read_audio()
                
                # 2. Math (Using our new fft.py file)
                # This returns a list of 64 magnitudes
                mags = fft.get_magnitude(raw_data)
                
                # 3. Display
                self.draw_spectrum(mags)
                
            except KeyboardInterrupt:
                print("Stopping.")
                break
            except Exception as e:
                print("Error:", e)
                time.sleep(1)

if __name__ == "__main__":
    analyzer = SpectrumAnalyzer()
    analyzer.run()
