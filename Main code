import machine
import time
import fft  # Import our new pure python library
from sh1106 import SH1106_I2C

# --- Hardware Configuration ---
I2C_SCL_PIN = 22
I2C_SDA_PIN = 21
OLED_WIDTH  = 128
OLED_HEIGHT = 64
MIC_PIN = 34 

# --- FFT Configuration ---
SAMPLE_LENGTH = 128 

# --- ZOOM SETTINGS ---
# Change these to zoom in on specific parts of the audio
# Previous auto-scale was approx 0 to 10000Hz.
# User Request: 100Hz to 1000Hz (Bass/Low Mids)
MIN_FREQ_HZ = 100  
MAX_FREQ_HZ = 1000 

class SpectrumAnalyzer:
    def __init__(self):
        self.setup_display()
        self.setup_mic()
        
        # --- AUTO-CALIBRATION ---
        self.real_sampling_rate = self.measure_sampling_rate()
        self.max_detectable_freq = self.real_sampling_rate / 2
        
        # Calculate Frequency per Bin (Hz Resolution)
        # e.g., if rate is 6000Hz, and samples is 128, resolution is ~46Hz per bin.
        self.hz_per_bin = self.real_sampling_rate / SAMPLE_LENGTH
        
        print(f"Sampling Rate: {self.real_sampling_rate} Hz")
        print(f"Resolution: {self.hz_per_bin:.1f} Hz per bar")

    def setup_display(self):
        print("Initializing SH1106 OLED...")
        i2c = machine.I2C(0, scl=machine.Pin(I2C_SCL_PIN), sda=machine.Pin(I2C_SDA_PIN), freq=400000)
        
        try:
            self.oled = SH1106_I2C(i2c)
        except TypeError:
            self.oled = SH1106_I2C(OLED_WIDTH, OLED_HEIGHT, i2c)
            
        self.oled.fill(0)
        self.oled.text("Calibrating...", 10, 30)
        self.oled.show()

    def setup_mic(self):
        print("Initializing Mic...")
        self.adc = machine.ADC(machine.Pin(MIC_PIN))
        self.adc.width(machine.ADC.WIDTH_12BIT) 
        self.adc.atten(machine.ADC.ATTN_11DB)   

    def read_audio(self):
        raw_samples = []
        adc_read = self.adc.read
        for _ in range(SAMPLE_LENGTH):
            raw_samples.append(adc_read())
        return raw_samples

    def measure_sampling_rate(self):
        # Warmup
        self.read_audio()
        
        total_time_us = 0
        iterations = 5
        
        for _ in range(iterations):
            start = time.ticks_us()
            self.read_audio()
            end = time.ticks_us()
            total_time_us += time.ticks_diff(end, start)
            
        avg_time_per_block = total_time_us / iterations
        avg_time_per_sample_us = avg_time_per_block / SAMPLE_LENGTH
        hz = 1000000 / avg_time_per_sample_us
        return int(hz)

    def draw_spectrum(self, magnitudes):
        self.oled.fill(0)
        
        DIVISOR = 25 
        BAR_BOTTOM = 54 
        
        # 1. Filter Data to Zoom Range
        # Calculate which array indices correspond to our Hz range
        start_index = int(MIN_FREQ_HZ / self.hz_per_bin)
        end_index = int(MAX_FREQ_HZ / self.hz_per_bin)
        
        # Safety Checks
        if start_index < 0: start_index = 0
        if end_index >= len(magnitudes): end_index = len(magnitudes) - 1
        if end_index <= start_index: end_index = start_index + 1
        
        # Slice the data to only the bars we want
        zoom_data = magnitudes[start_index:end_index]
        num_bars = len(zoom_data)
        
        # 2. Calculate Dynamic Bar Width
        # Stretch the bars to fill the 128px width
        if num_bars > 0:
            bar_width = int(OLED_WIDTH / num_bars)
        else:
            bar_width = 2
            
        # 3. Draw the Bars
        for i, mag in enumerate(zoom_data):
            h = int(mag / DIVISOR)
            if h > BAR_BOTTOM: h = BAR_BOTTOM
            
            x_pos = i * bar_width
            
            # fill_rect(x, y, w, h, c)
            # We subtract 1 from width to leave a tiny gap between bars for looks
            w = bar_width - 1 if bar_width > 2 else bar_width
            
            self.oled.fill_rect(x_pos, BAR_BOTTOM - h, w, h, 1)
            
        # 4. Draw Scale & Labels
        self.oled.hline(0, BAR_BOTTOM + 1, 128, 1)
        
        # Draw Left Label
        self.oled.text(str(MIN_FREQ_HZ), 0, 56)
        
        # Draw Right Label (1000 -> 1k)
        if MAX_FREQ_HZ >= 1000:
            right_lbl = f"{MAX_FREQ_HZ//1000}k"
        else:
            right_lbl = str(MAX_FREQ_HZ)
            
        # Align right text roughly
        self.oled.text(right_lbl, 128 - (len(right_lbl)*8), 56)
            
        self.oled.show()

    def run(self):
        print("Starting Spectrum Analyzer...")
        while True:
            try:
                raw_data = self.read_audio()
                mags = fft.get_magnitude(raw_data)
                self.draw_spectrum(mags)
            except KeyboardInterrupt:
                print("Stopping.")
                break
            except Exception as e:
                print("Error:", e)
                time.sleep(1)

if __name__ == "__main__":
    analyzer = SpectrumAnalyzer()
    analyzer.run()
